{
  "name": "dateiaustausch-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "coverage": "node --import tsx --test --experimental-test-coverage '--test-coverage-include=src/**/*.ts' tests/*.test.ts",
    "mail:test": "node --env-file=.env --import tsx tests/resend-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.13",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
