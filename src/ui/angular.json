{
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "medconemy": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "outputPath": "dist/medconemy",
            "outputHashing": "all"
          },
          "configurations": {
            "development": { "optimization": false, "sourceMap": true }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "medconemy:build:development", "proxyConfig": "proxy.conf.json" }
        }
      }
    }
  }
}
